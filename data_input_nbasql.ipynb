   "source": [
    "df = pd.read_csv('Player_Season_stats.csv', delimiter=';' , encoding=\"cp1252\")\n",
    "\n",
    "# --- Keep only first entry for each player (skip TOT/MIN duplicates) ---\n",
    "df = df.drop_duplicates(subset=['Player'], keep='first')"
   ]
