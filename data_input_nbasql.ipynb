  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "b7c83a5e-e8cc-45ff-bebf-cb22db559aaa",
   "metadata": {},
   "outputs": [],
   "source": [
    "index = 1\n",
    "for _, row in df.iterrows():\n",
    "\n",
    "    try:\n",
    "        # Insert into Player\n",
    "        cur.execute(\"\"\"\n",
    "            INSERT INTO Team (team_id, name)\n",
    "            VALUES (%s, %s)\n",
    "        \"\"\", (index,row['Team']))\n",
    "\n",
    "        #print(f\"Inserted {team_name}\")\n",
    "        index = index+1\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"Error inserting {row['Team']}: {e}\")\n",
    "\n",
    "conn.commit()"
   ]
  },
  {
   "cell_type": "code",
