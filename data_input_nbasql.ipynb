    "import pandas as pd\n",
    "import psycopg2\n",
    "import hashlib"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "658ea1e0-5cc6-41e0-b66c-b461a04134ac",
   "metadata": {},
   "outputs": [],
   "source": [
    "df = pd.read_csv('nba_teams.csv', delimiter=',' )\n",
    "conn = psycopg2.connect(\n",
    "    dbname=\"nba_sql4\",\n",
    "    user=\"postgres\",\n",
    "    password=\"1234\",\n",
    "    host=\"localhost\",\n",
    "    port=\"5432\"\n",
    ")\n",
    "cur = conn.cursor()\n",
    "SEASON_ID = 1"
   ]
  },
